# 开发（npm run dev）：Vite 将 /api 代理到知库后端（默认 knowbase-app :8010）
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8010
VITE_BACKEND_URL=http://127.0.0.1:8010

# kanhai 宿主在 8080、知库独立在 8010 时（方案 B），不要指到 8080：
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8010

# 生产构建（npm run build）部署到静态服务器时，指向真实知库 API：
# VITE_API_BASE=http://192.168.1.10:8010
# VITE_BACKEND_URL=http://192.168.1.10:8010
