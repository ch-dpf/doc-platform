<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.knowbase</groupId>
        <artifactId>knowbase</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>knowbase-autoconfigure</artifactId>
    <name>knowbase-autoconfigure</name>
    <dependencies>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-web</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-ingestion</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-retrieval</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-preset</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-tokenizer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowbase</groupId>
            <artifactId>knowbase-persistence</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
